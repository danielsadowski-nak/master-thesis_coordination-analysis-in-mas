# Copy this file to .env and fill in the values you want to use for local runs.
# The project automatically reads .env from the repository root.

# OpenAI-compatible credentials
MAS_LLM_API_KEY=
MAS_LLM_BASE_URL=

# Core experiment parameters
MAS_FRAMEWORK=langgraph
MAS_BENCHMARK=coordination_suite
MAS_BENCHMARK_SOURCE=
MAS_TASK_DESCRIPTION=Solve the benchmark task with a controlled multi-agent workflow while recording all coordination artifacts for later MAST analysis.
MAS_MAX_STEPS=25
MAS_NUM_RUNS=3
MAS_SEED=42
MAS_MODEL_NAME=gpt-4o-mini
MAS_TEMPERATURE=0.0
MAS_JUDGE_MODEL_NAME=gpt-4o
MAS_MAST_JUDGE_ENABLED=false
MAS_MAST_JUDGE_TEMPERATURE=0.0
MAS_MAST_JUDGE_MAX_RETRIES=2

# Optional LangSmith tracing
MAS_LANGSMITH_ENABLED=false
MAS_LANGSMITH_PROJECT=mas-coordination-analysis
MAS_LANGSMITH_API_KEY=
MAS_LANGSMITH_ENDPOINT=
# Comma-separated tags, e.g. thesis,validation
MAS_LANGSMITH_TAGS=
